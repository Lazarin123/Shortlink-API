PORT=3000
# URL pública do seu serviço (usada para montar o link curto). Ex: https://meu-short.onrender.com
BASE_URL=http://localhost:3000
# Chave para rotas administrativas (listar/deletar). Gere uma forte: openssl rand -hex 24
API_KEY=troque-esta-chave
# Se true, criar links também exige a chave (recomendado em produção)
CREATE_REQUIRES_KEY=false
# Sites autorizados a chamar a API pelo navegador (separe por vírgula) ou * para todos
CORS_ORIGIN=*
# Sal usado para anonimizar IPs (LGPD). Troque por um texto aleatório.
IP_SALT=troque-este-sal
# Caminho do banco SQLite (em hospedagem com volume, aponte para o volume)
DB_PATH=./data/shortlink.db
